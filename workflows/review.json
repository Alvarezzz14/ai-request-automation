{
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  },
  "pinData": {},
  "id": "aiRequestsReview1",
  "name": "AI Requests - Review",
  "nodes": [
    {
      "id": "review",
      "name": "Review",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "automation/review",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "a6fc1f52-ec8a-58b6-8974-31988e93a6bb"
    },
    {
      "id": "decision",
      "name": "Decision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        250,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AUTOMATION_API_URL + '/requests/' + encodeURIComponent($json.body.request_id) + '/decision' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $json.headers['x-api-key'] || '' }}"
            },
            {
              "name": "X-Reviewer-Key",
              "value": "={{ $json.headers['x-reviewer-key'] || '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { decision: $json.body.decision } }}",
        "options": {
          "timeout": 80000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "retryOnFail": false
    },
    {
      "id": "publish-once",
      "name": "Publish once",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        500,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "publish-authorized",
              "leftValue": "={{ $json.statusCode === 200 && $json.body.should_publish === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "create-issue",
      "name": "Create issue",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        750,
        -100
      ],
      "parameters": {
        "resource": "issue",
        "operation": "create",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $json.body.publication.owner }}"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $json.body.publication.repository }}"
        },
        "title": "={{ $json.body.publication.title }}",
        "body": "={{ $json.body.publication.body }}",
        "labels": [],
        "assignees": []
      },
      "credentials": {
        "githubApi": {
          "id": "automation-github",
          "name": "Automation GitHub"
        }
      },
      "retryOnFail": false,
      "onError": "continueErrorOutput"
    },
    {
      "id": "confirm-publication",
      "name": "Confirm publication",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        -180
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AUTOMATION_API_URL + '/requests/' + encodeURIComponent($('Review').first().json.body.request_id) + '/publication-success' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AUTOMATION_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { claim_token: $('Decision').first().json.body.publication.claim_token, issue_number: $json.number } }}",
        "options": {
          "timeout": 80000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "retryOnFail": false
    },
    {
      "id": "mark-uncertain",
      "name": "Mark uncertain",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        60
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AUTOMATION_API_URL + '/requests/' + encodeURIComponent($('Review').first().json.body.request_id) + '/publication-failure' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AUTOMATION_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { claim_token: $('Decision').first().json.body.publication.claim_token } }}",
        "options": {
          "timeout": 80000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "retryOnFail": false
    },
    {
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1250,
        180
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.body }}",
        "options": {
          "responseCode": "={{ $json.statusCode }}"
        }
      }
    }
  ],
  "connections": {
    "Review": {
      "main": [
        [
          {
            "node": "Decision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Decision": {
      "main": [
        [
          {
            "node": "Publish once",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish once": {
      "main": [
        [
          {
            "node": "Create issue",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create issue": {
      "main": [
        [
          {
            "node": "Confirm publication",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mark uncertain",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirm publication": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark uncertain": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "versionId": "18905d68-6324-4582-ae5e-b0c6e7e9982d"
}
